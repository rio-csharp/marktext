shamefully-hoist=true
# Use the installed VS2026 (v145 toolset) instead of pinning to 2022.
# node-gyp's VisualStudioFinder rejects versions that don't match msvs_version,
# and this machine runs Visual Studio Community 2026 (version 18.x / v145).
msvs_version=2026
clang=0
# Forces electron/rebuild to use gcc/g++ instead of clang on Linux and msvc on Windows